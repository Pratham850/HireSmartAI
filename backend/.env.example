# Environment Configuration for HireSmart AI
PROJECT_NAME="HireSmart AI - Campus Recruitment Automation System"
VERSION="1.0.0"
DEBUG=True

# Database Configuration (Async MySQL with SQLite fallback support)
DATABASE_URL="mysql+aiomysql://root:your_mysql_password_here@localhost:3306/hiresmart_db"
# Fallback SQLite Async for local test without MySQL running:
# DATABASE_URL="sqlite+aiosqlite:///./hiresmart_dev.db"

# Security & JWT Authentication
SECRET_KEY="your_super_secret_jwt_key_here_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq AI Service API Key & Model
GROQ_API_KEY="your_groq_api_key_here"
MODEL="llama-3.3-70b-versatile"

# Sentence Transformers Vector Embedding Model
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Storage Directories
UPLOAD_DIR="uploads"
PDF_DIR="uploads/pdf"
JSON_DIR="uploads/json"
REPORT_DIR="reports"

# Email SMTP Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="recruitment@hiresmart.ai"
SMTP_PASSWORD="your_app_password_here"
EMAIL_FROM="recruitment@hiresmart.ai"
